        <mxCell id="LsRcc9bGGXNNcb2lxGNg-21" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size:12px;&quot; color=&quot;#8C857A&quot;&gt;&lt;i&gt;state is a function of the events — not the other way round&lt;/i&gt;&lt;/font&gt;" vertex="1" parent="layer-labels" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Georgia;">
