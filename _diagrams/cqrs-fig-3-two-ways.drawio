        <mxCell id="LsRcc9bGGXNNcb2lxGNg-18" value="&lt;font face=&quot;Georgia&quot; style=&quot;font-size:12px;&quot; color=&quot;#8C857A&quot;&gt;&lt;i&gt;one event per thing that happened · appended only at the right end&lt;/i&gt;&lt;/font&gt;" vertex="1" parent="layer-labels" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Georgia;">
