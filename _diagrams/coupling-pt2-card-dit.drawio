        <mxCell id="zj7m3jaAhIuQTaKvK5fx-12" value="&lt;b&gt;Admin(User, AuditMixin)&lt;/b&gt; has two parents:&lt;br&gt;DIT = 1 + max(1, 0) = 2. The longest path wins." vertex="1" parent="layer-labels" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=4;fontFamily=Georgia;fontSize=15;fontColor=#4D4D4D;">
