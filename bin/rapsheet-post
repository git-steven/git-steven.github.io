#!/usr/bin/env python3
"""Generate the "Reading the Rap Sheet" post from the rapsheet repo's docs/rapsheet.md.

    bin/rapsheet-post                      # ~/src/rapsheet/docs/rapsheet.md → _posts/ + assets/images/
    bin/rapsheet-post path/to/rapsheet.md  # another copy of the source

The doc in the rapsheet repo is the source of truth. This script adds the Jekyll front matter,
turns the H1 + tagline into the post's header, copies docs/images/* into assets/images/, and
rewrites the relative image paths to the raw GitHub URLs the other posts use. Edit the doc, rerun
this, commit both.
"""

import re
import shutil
import sys
from datetime import date
from pathlib import Path

BLOG = Path(__file__).resolve().parent.parent
SOURCE = Path.home() / 'src' / 'rapsheet' / 'docs' / 'rapsheet.md'
POST = BLOG / '_posts' / '2026-10-20-reading-the-rap-sheet.md'
ASSETS = BLOG / 'assets' / 'images'
RAW = 'https://raw.githubusercontent.com/git-steven/git-steven.github.io/master/assets/images/'

FRONT_MATTER = """---
title: "{title}"
tagline: "{tagline}"
excerpt: "{excerpt}"
date: 2026-10-20 09:00:00 -0500
categories:
  - architecture
  - ai
  - ml
tags: [ai, ml, calibration, selective-classification, hitl, open-data]
author: steven
published: true
toc: true
---

## 📝 Introduction
"""


def main(source: Path) -> int:
  text = source.read_text(encoding='utf-8')
  title = re.search(r'^# (.+)$', text, re.M).group(1).strip()
  tagline = re.search(r'^\*(.+)\*$', text, re.M).group(1).strip()
  excerpt = re.search(r'^\*\*(.+)\*\*$', text, re.M).group(1).strip()
  body = text.split(f'*{tagline}*', 1)[1].lstrip('\n')

  copied = []
  for match in sorted(set(re.findall(r'\]\((images/[^)]+)\)', body))):
    image = source.parent / match
    if not image.is_file():
      sys.exit(f'missing image: {image}')
    ASSETS.mkdir(parents=True, exist_ok=True)
    shutil.copy2(image, ASSETS / image.name)
    copied.append(image.name)
  body = re.sub(r'\]\(images/([^)]+)\)', lambda m: f']({RAW}{m.group(1)})', body)

  front = FRONT_MATTER.format(title=title, tagline=tagline, excerpt=excerpt)
  POST.write_text(front + body, encoding='utf-8')
  print(f'{POST.relative_to(BLOG)} ← {source} ({date.today()})')
  for name in copied:
    print(f'  assets/images/{name}')
  return 0


if __name__ == '__main__':
  sys.exit(main(Path(sys.argv[1]) if len(sys.argv) > 1 else SOURCE))
