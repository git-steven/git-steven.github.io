        <mxCell id="call-A" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 15px;&quot;&gt;Class A — the big auto-decider&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;the largest share of traffic&lt;/li&gt;&lt;li&gt;decides nearly all of it alone, inside the budget&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#BFD8D5;gradientColor=#5D9499;gradientDirection=south;strokeColor=#3B6E73;strokeWidth=2;fontFamily=Georgia;fontSize=12;fontColor=#1E3B3E;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
          <mxGeometry x="1000" y="160" width="285" height="76" as="geometry" />
        </mxCell>
        <mxCell id="lead-A" value="" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=1.5;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;dashed=1;dashPattern=1 3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cls-A" target="call-A">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="call-D" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 15px;&quot;&gt;Class D — moved down&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;↓ drift alarm: at the same τ, coverage fell on inputs it had not seen&lt;/li&gt;&lt;li&gt;back on the loop until it re-earns the rung&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#F8CECC;gradientColor=#EA6B66;gradientDirection=south;strokeColor=#991B1B;strokeWidth=2;fontFamily=Georgia;fontSize=12;fontColor=#7F1D1D;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
          <mxGeometry x="1000" y="250" width="285" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lead-D" value="" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=1.5;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;dashed=1;dashPattern=1 3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cls-D" target="call-D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="call-C" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 15px;&quot;&gt;Class C — climbing&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;↑ calibrated, then retrained on overrides&lt;/li&gt;&lt;li&gt;coverage at budget rose past 50%&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#C9EBD3;gradientColor=#22A565;gradientDirection=south;strokeColor=#1E7A45;strokeWidth=2;fontFamily=Georgia;fontSize=12;fontColor=#0F3D22;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
          <mxGeometry x="1000" y="372" width="285" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lead-C" value="" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=1.5;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;dashed=1;dashPattern=1 3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cls-C" target="call-C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="call-B" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 15px;&quot;&gt;Class B — never qualifies&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;no τ meets the budget from the record as it stands&lt;/li&gt;&lt;li&gt;a person decides, until the record carries more signal&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#F5C283;gradientColor=#C48653;gradientDirection=south;strokeColor=#9A5B2B;strokeWidth=2;fontFamily=Georgia;fontSize=12;fontColor=#4A2C14;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
          <mxGeometry x="1000" y="528" width="285" height="92" as="geometry" />
        </mxCell>
        <mxCell id="lead-B" value="" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=1.5;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;dashed=1;dashPattern=1 3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cls-B" target="call-B">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 15px;&quot;&gt;Legend&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;circle area = share of traffic&lt;/li&gt;&lt;li&gt;dashed ring = where the class was&lt;/li&gt;&lt;li&gt;solid ↑ = earned on evidence&lt;/li&gt;&lt;li&gt;dashed ↓ = drift alarm, back down a rung&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#EFEAE0;gradientColor=#CFC7B8;gradientDirection=south;strokeColor=#8C857A;strokeWidth=2;fontFamily=Georgia;fontSize=12;fontColor=#4B4741;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;opacity=80;">
          <mxGeometry x="1000" y="636" width="285" height="108" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="&lt;i&gt;A class climbs only on evidence — honest confidence and ≤ 1% error among what it decides alone — and drops a rung the moment coverage falls.&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#F5F5F5;gradientColor=#D9D5CC;gradientDirection=south;strokeColor=#B1ACA2;strokeWidth=1;fontFamily=Georgia;fontSize=15;fontColor=#4D4D4D;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
          <mxGeometry x="30" y="760" width="1255" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
