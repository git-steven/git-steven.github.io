        <mxCell id="vUFMAVH2sz9snMTMh8E3-22" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 20px;&quot;&gt;🧮 The math&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;methods m = 4, fields a = 4&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;LCOM4 = 2   (islands)&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;LCOM1 = P − Q = 4 − 2 = 2&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;LCOM* = (1.5 − 4)/(1 − 4) ≈ 0.83&lt;/font&gt;" vertex="1" parent="layer-diagram" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;gradientColor=#7EA6E0;gradientDirection=south;strokeColor=#556B98;strokeWidth=2;fontFamily=Georgia;fontSize=15;fontColor=#32465D;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;spacingLeft=20;">
