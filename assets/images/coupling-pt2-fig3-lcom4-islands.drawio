        <mxCell id="vUFMAVH2sz9snMTMh8E3-23" value="&lt;font face=&quot;Architects Daughter&quot; style=&quot;font-size: 20px;&quot;&gt;✂️ The verdict&lt;/font&gt;&lt;ul style=&quot;margin: 2px 0 0 0; padding-left: 16px;&quot;&gt;&lt;li&gt;Two classes share one name.&lt;/li&gt;&lt;li&gt;Split along the islands: Credentials and BillingProfile.&lt;/li&gt;&lt;li&gt;Each new class has LCOM4 = 1.&lt;/li&gt;&lt;/ul&gt;" vertex="1" parent="layer-diagram" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;gradientColor=#FFD966;gradientDirection=south;strokeColor=#B58900;strokeWidth=2;fontFamily=Georgia;fontSize=15;fontColor=#6B5200;sketch=1;sketchStyle=comic;jiggle=1;curveFitting=1;shadow=1;shadowOpacity=75;shadowOffsetX=6;shadowOffsetY=5;shadowBlur=4;">
